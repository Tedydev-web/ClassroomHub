client_secret_*.apps.googleusercontent.com.json

# turbo
.turbo

# vercel
.vercel

vite.config.ts*.mjs

.pnpm-store/*

**/dist/*

#Ignore vscode AI rules
.github/instructions/codacy.instructions.md

tsconfig.tsbuildinfo*

# Stray TS build artifacts emitted next to sources (e.g. from `tsc <file>` without project)
apps/api/src/**/*.js
apps/api/src/**/*.js.map
apps/api/src/**/*.d.ts
!apps/api/src/types/css-tree.d.ts

storybook-static

.svelte-kit/

company/

# Claude Code local artifacts
.claude/skills
.claude/scheduled_tasks.lock

# Local db-agent playground (not committed)
apps/db-agent

# Generated htpasswd files (hashes are safe to store in secrets/CI, plaintext never committed)
.htpasswd
*.htpasswd

# Keep repository script tests even when a global ignore excludes tests/ directories.
!scripts/tests/
!scripts/tests/*.test.mjs

# Keep focused API entitlement coverage even when a global ignore excludes test files.
!apps/api/src/services/deployment-entitlements.test.ts
!apps/api/src/services/course/completion.test.ts
!apps/api/src/services/course/public-course-guard.test.ts
!apps/api/src/services/exercise/file-upload.test.ts
!apps/api/src/services/exercise/video-recording-access.test.ts

# Keep assessment foundation coverage even when a global ignore excludes test files.
!apps/api/src/services/exercise/question-revision-db.integration.test.ts
!apps/api/src/services/submission/*.test.ts
!apps/dashboard/src/lib/features/course/utils/exercise-autosave-utils.test.ts
!packages/question-types/tests/
!packages/question-types/tests/*.test.ts
!packages/exam-import/tests/
!packages/exam-import/tests/*.test.ts
!packages/utils/scripts/exercise-question-type-validation.test.ts

# Keep the gateway allowlist picker-model coverage even when a global ignore excludes test files.
!apps/api/src/__tests__/
!apps/api/src/__tests__/picker-models.test.ts

# Keep canonical product brand sources and generated masters in the repository.
!docs/
!docs/brand/
!docs/brand/**

# Stray brand-kit export drop at repo root — canonical brand sources live in docs/brand/
/ClassroomHub_Icon_Assets_v2/

# Fumadocs generated output (docs site migrated to Blume)
apps/docs/.source/
!apps/api/src/__tests__/dashboard-base-url.test.ts

# Keep the host-authoritative tenant-routing coverage even when a global ignore excludes test files.
!apps/dashboard/src/lib/utils/functions/tenant-host-redirect.test.ts

# Exam-import corpus: small source documents are committed so CI can score the
# reader; large scans are not, because they never change and would bloat history
# permanently. `fixtures/exams/manifest.json` records their checksums, and the
# harness reports a missing document instead of silently scoring a smaller corpus.
fixtures/exams/large/
