{
  "name": "@cio/exam-import",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc && tsc-alias",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:corpus": "vitest run tests/corpus-metrics.test.ts",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@cio/question-types": "workspace:*",
    "@cio/tsconfig": "workspace:*",
    "fast-xml-parser": "5.2.5",
    "jszip": "3.10.1",
    "officeparser": "^7.4.0",
    "pdfjs-dist": "6.1.200",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.5.2",
    "vitest": "^1.2.2"
  }
}
