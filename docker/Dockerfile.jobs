FROM node:22.23.1-bookworm-slim AS builder

# ffmpeg is needed for media probe / thumbnail / audio-extract / transcode tasks.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Keep install non-interactive and deterministic in CI/container contexts.
ENV CI=true
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@10.19.0 --activate

# Fetch deps from the lockfile first (cached unless pnpm-lock.yaml changes); the
# store is baked into this layer and reused by the offline install below. `pnpm
# fetch` populates the store for the whole lockfile, so no hand-maintained package
# list. Mirrors the api/dashboard images.
COPY pnpm-lock.yaml ./
# Patched deps in the lockfile are hashed against these files, so `pnpm fetch` needs them.
COPY patches ./patches
RUN pnpm fetch --store-dir /pnpm/store

COPY . .

RUN pnpm install --offline --frozen-lockfile --ignore-scripts \
    --store-dir /pnpm/store --filter @cio/jobs-worker...
RUN find . -name 'tsconfig.tsbuildinfo' -delete
# Build the worker and all its workspace deps in topological order.
RUN pnpm -r --filter @cio/jobs-worker... build


# The runtime image starts clean and takes only `/app` from the builder.
#
# Everything above stays behind, and the reason is measurable: `pnpm fetch` bakes the
# package store into a layer, and that store is 2.3 GB the container never reads. Shipping
# it made every image about 4.5 GB, which had to be pushed from the build runner and pulled
# again on the production host on every deploy — three minutes of the deploy spent moving
# a package cache that nothing runs. `/app` is copied whole and unchanged, so what runs
# here is identical to what the single-stage image ran.

# ffmpeg is installed again rather than copied: the media tasks shell out to it, and its
# shared libraries are spread across the base image rather than sitting in one directory.
FROM node:22.23.1-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV CI=true
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@10.19.0 --activate

COPY --from=builder /app /app

# Run all worker entrypoints by default. Override CMD to scale media / transcribe
# / maintenance independently.
CMD ["node", "apps/jobs/dist/index.js"]
