# syntax=docker/dockerfile:1
FROM node:24.22.1-bookworm-slim

# ffmpeg is needed for media probe / thumbnail / audio-extract / transcode tasks.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG TURBO_TEAM
ENV TURBO_TEAM="${TURBO_TEAM}"

# Keep install non-interactive and deterministic in CI/container contexts.
ENV CI=true
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@10.19.0 --activate
RUN npm i -g turbo@1.13.4

# Fetch deps from the lockfile first (cached unless pnpm-lock.yaml changes); the
# store is kept in a BuildKit cache mount and reused by the offline install below
# without bloating the final container image layer.
COPY pnpm-lock.yaml ./
# Patched deps in the lockfile are hashed against these files, so `pnpm fetch` needs them.
COPY patches ./patches
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm fetch --store-dir /pnpm/store

COPY . .

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts \
    --store-dir /pnpm/store --filter @cio/jobs-worker...
RUN find . -name 'tsconfig.tsbuildinfo' -delete
# Build the worker and all its workspace deps in topological order.
RUN --mount=type=cache,target=/app/.turbo \
    --mount=type=secret,id=TURBO_TOKEN \
    export TURBO_TOKEN="$(cat /run/secrets/TURBO_TOKEN 2>/dev/null || true)" && \
    turbo run build --filter=@cio/jobs-worker --concurrency=1

# Reported in self-hosted usage pings. Set last so a new version doesn't bust the build cache.
ARG CIO_VERSION=dev
ENV CIO_VERSION=$CIO_VERSION

# Run all worker entrypoints by default. Override CMD to scale media / transcribe
# / maintenance independently.
CMD ["node", "apps/jobs/dist/index.js"]
