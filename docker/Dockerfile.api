FROM node:22.23.1-slim AS builder

WORKDIR /app

# Keep install non-interactive and deterministic in CI/container contexts.
ENV CI=true
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@10.19.0 --activate

# Fetch deps from the lockfile first (cached unless pnpm-lock.yaml changes); the
# store is baked into this layer and reused by the offline install below.
COPY pnpm-lock.yaml ./
# Patched deps in the lockfile are hashed against these files, so `pnpm fetch` needs them.
COPY patches ./patches
RUN pnpm fetch --store-dir /pnpm/store

COPY . .

RUN pnpm install --offline --frozen-lockfile --ignore-scripts --shamefully-hoist \
    --store-dir /pnpm/store --filter @cio/api...
RUN find . -name 'tsconfig.tsbuildinfo' -delete
RUN pnpm -r --filter @cio/api... build


# The runtime image starts clean and takes only `/app` from the builder.
#
# Everything above stays behind, and the reason is measurable: `pnpm fetch` bakes the
# package store into a layer, and that store is 2.3 GB the container never reads. Shipping
# it made every image about 4.5 GB, which had to be pushed from the build runner and pulled
# again on the production host on every deploy — three minutes of the deploy spent moving
# a package cache that nothing runs. `/app` is copied whole and unchanged, so what runs
# here is identical to what the single-stage image ran.

# pnpm itself is kept, unlike the store: the entrypoint starts the API through it, and the
# `db-migrate` service runs `pnpm --filter @cio/db db:setup` against this same image.
FROM node:22.23.1-slim

WORKDIR /app

ENV CI=true
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@10.19.0 --activate

COPY --from=builder /app /app

COPY docker/entrypoint-api.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 3081

ENV NODE_ENV=production \
    PORT=3081

ENTRYPOINT ["/app/entrypoint.sh"]
