# syntax=docker/dockerfile:1
FROM node:22.23.1-slim

WORKDIR /app

ENV CI=true
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@10.19.0 --activate
RUN npm i -g turbo@1.13.4

# Fetch deps from the lockfile first (cached unless pnpm-lock.yaml changes); the
# store is baked into this layer and reused by the offline install below.
COPY pnpm-lock.yaml ./
# Patched deps in the lockfile are hashed against these files, so `pnpm fetch` needs them.
COPY patches ./patches
RUN pnpm fetch --store-dir /pnpm/store

COPY . .

RUN pnpm install --offline --frozen-lockfile --ignore-scripts \
    --store-dir /pnpm/store --filter @cio/admin...
RUN find . -name 'tsconfig.tsbuildinfo' -delete
RUN --mount=type=cache,target=/app/.turbo \
  turbo run build --filter=@cio/admin --concurrency=1

RUN test -f apps/admin/build/index.js || (echo "ERROR: admin output missing" && exit 1)

EXPOSE 3083

ENV NODE_ENV=production \
    PORT=3083

WORKDIR /app/apps/admin
CMD ["node", "build/index.js"]
