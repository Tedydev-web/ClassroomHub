# syntax=docker/dockerfile:1
FROM node:24.22.1-slim

WORKDIR /app

ENV CI=true
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

ARG PUBLIC_IS_SELFHOSTED=false
ARG PUBLIC_IS_SELF_OWNED=true
ARG TURBO_TEAM
ENV TURBO_TEAM="${TURBO_TEAM}"

LABEL io.classroom.public-is-selfhosted="${PUBLIC_IS_SELFHOSTED}" \
      io.classroom.public-is-self-owned="${PUBLIC_IS_SELF_OWNED}"

RUN corepack enable && corepack prepare pnpm@10.19.0 --activate
RUN npm i -g turbo@1.13.4

# Fetch deps from the lockfile first (cached unless pnpm-lock.yaml changes); the
# store is kept in a BuildKit cache mount and reused by the offline install below
# without bloating the final container image layer.
COPY pnpm-lock.yaml ./
# Patched deps in the lockfile are hashed against these files, so `pnpm fetch` needs them.
COPY patches ./patches
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm fetch --store-dir /pnpm/store

COPY . .

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts \
    --store-dir /pnpm/store --filter @cio/dashboard...
RUN find . -name 'tsconfig.tsbuildinfo' -delete
RUN --mount=type=cache,target=/app/.turbo \
    --mount=type=secret,id=TURBO_TOKEN \
    export TURBO_TOKEN="$(cat /run/secrets/TURBO_TOKEN 2>/dev/null || true)" && \
    NODE_OPTIONS="--max-old-space-size=8072" \
    PUBLIC_IS_SELFHOSTED="${PUBLIC_IS_SELFHOSTED}" \
    PUBLIC_IS_SELF_OWNED="${PUBLIC_IS_SELF_OWNED}" \
    turbo run build --filter=@cio/dashboard --concurrency=1

RUN test -f apps/dashboard/build/index.js || (echo "ERROR: Dashboard build output not found at apps/dashboard/build/index.js" && exit 1)

EXPOSE 3000

ENV NODE_ENV=production \
    PORT=3000 \
    PUBLIC_IS_SELFHOSTED=${PUBLIC_IS_SELFHOSTED} \
    PUBLIC_IS_SELF_OWNED=${PUBLIC_IS_SELF_OWNED}

WORKDIR /app/apps/dashboard
CMD ["node", "build/index.js"]
