# The image a deploy actually moves across the network, built in three stages so the two
# expensive ones do not wait for each other.
#
# It used to be one stage, so what shipped was the builder: the pnpm store, every dev
# dependency, the whole monorepo and the build output — 4.55GB, of which roughly half a
# gigabyte changed on every commit. Splitting the build away from what runs cut that to
# 1.75GB and left one layer that changes per commit.
#
# The first split cost more than it saved. Resolving the production dependency tree ran
# *after* the build, so its two and a half minutes were added to every deploy, and a
# smaller image only pays that back on a slow line. The two are independent — one needs the
# compiler, the other needs the lockfile — so they are separate stages now, and BuildKit
# runs them at the same time. The wall clock is the longer of the two rather than the sum.

# The workspace with its dependencies installed: the point both branches start from, so the
# fetch and the install are done once and shared.
FROM node:22.23.1-slim AS workspace

WORKDIR /app

ENV CI=true
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@10.19.0 --activate

# Fetch deps from the lockfile first (cached unless pnpm-lock.yaml changes); the
# store is baked into this layer and reused by the offline install below.
COPY pnpm-lock.yaml ./
# Patched deps in the lockfile are hashed against these files, so `pnpm fetch` needs them.
COPY patches ./patches
RUN pnpm fetch --store-dir /pnpm/store

COPY . .

RUN pnpm install --offline --frozen-lockfile --ignore-scripts \
    --store-dir /pnpm/store --filter @cio/dashboard...

# What the app needs at run time, resolved out of the workspace.
#
# The server bundle is not self-contained — it imports `axios`, `zod`, `dayjs`, `marked` and
# others at run time — so the output alone starts and then fails on the first request.
# `pnpm deploy` turns the workspace links into a plain `node_modules`, which is the only
# form that survives being copied between stages. It needs no compiler and no build output,
# which is why it does not wait for one.
FROM workspace AS deps

RUN pnpm deploy --filter @cio/dashboard --prod --legacy /deploy

# The build itself.
FROM workspace AS builder

ARG PUBLIC_IS_SELFHOSTED=false
ARG PUBLIC_IS_SELF_OWNED=true

RUN find . -name 'tsconfig.tsbuildinfo' -delete
RUN NODE_OPTIONS="--max-old-space-size=8072" \
    PUBLIC_IS_SELFHOSTED="${PUBLIC_IS_SELFHOSTED}" \
    PUBLIC_IS_SELF_OWNED="${PUBLIC_IS_SELF_OWNED}" \
    pnpm --workspace-concurrency=1 -r --filter @cio/dashboard... build

RUN test -f apps/dashboard/build/index.js || (echo "ERROR: dashboard output missing" && exit 1)

FROM node:22.23.1-slim AS runtime

WORKDIR /app/apps/dashboard

ARG PUBLIC_IS_SELFHOSTED=false
ARG PUBLIC_IS_SELF_OWNED=true

LABEL io.classroom.public-is-selfhosted="${PUBLIC_IS_SELFHOSTED}" \
      io.classroom.public-is-self-owned="${PUBLIC_IS_SELF_OWNED}"

# Dependencies before the output, deliberately: this layer is keyed to the lockfile and is
# the large one, so an ordinary commit re-pulls only the small layer beneath it.
COPY --from=deps /deploy/node_modules ./node_modules
COPY --from=deps /deploy/package.json ./package.json
COPY --from=builder /app/apps/dashboard/build ./build

EXPOSE 3000

ENV NODE_ENV=production \
    PORT=3000 \
    PUBLIC_IS_SELFHOSTED=${PUBLIC_IS_SELFHOSTED} \
    PUBLIC_IS_SELF_OWNED=${PUBLIC_IS_SELF_OWNED}

CMD ["node", "build/index.js"]
