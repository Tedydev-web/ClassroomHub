FROM node:22.23.1-slim AS builder

WORKDIR /app

ENV CI=true
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

ARG PUBLIC_IS_SELFHOSTED=false
ARG PUBLIC_IS_SELF_OWNED=true

LABEL io.classroom.public-is-selfhosted="${PUBLIC_IS_SELFHOSTED}" \
      io.classroom.public-is-self-owned="${PUBLIC_IS_SELF_OWNED}"

RUN corepack enable && corepack prepare pnpm@10.19.0 --activate

# Fetch deps from the lockfile first (cached unless pnpm-lock.yaml changes); the
# store is baked into this layer and reused by the offline install below.
COPY pnpm-lock.yaml ./
# Patched deps in the lockfile are hashed against these files, so `pnpm fetch` needs them.
COPY patches ./patches
RUN pnpm fetch --store-dir /pnpm/store

COPY . .

RUN pnpm install --offline --frozen-lockfile --ignore-scripts \
    --store-dir /pnpm/store --filter @cio/dashboard...
RUN find . -name 'tsconfig.tsbuildinfo' -delete
RUN NODE_OPTIONS="--max-old-space-size=8072" \
    PUBLIC_IS_SELFHOSTED="${PUBLIC_IS_SELFHOSTED}" \
    PUBLIC_IS_SELF_OWNED="${PUBLIC_IS_SELF_OWNED}" \
    pnpm --workspace-concurrency=1 -r --filter @cio/dashboard... build

RUN test -f apps/dashboard/build/index.js || (echo "ERROR: Dashboard build output not found at apps/dashboard/build/index.js" && exit 1)


# The runtime image starts clean and takes only `/app` from the builder.
#
# Everything above stays behind, and the reason is measurable: `pnpm fetch` bakes the
# package store into a layer, and that store is 2.3 GB the container never reads. Shipping
# it made every image about 4.5 GB, which had to be pushed from the build runner and pulled
# again on the production host on every deploy — three minutes of the deploy spent moving
# a package cache that nothing runs. `/app` is copied whole and unchanged, so what runs
# here is identical to what the single-stage image ran.

# pnpm is kept here too, though this image starts node directly: the cost is a few
# megabytes, and an image that cannot run its own workspace tooling is a surprise waiting
# for whoever next needs a one-off command inside it.
FROM node:22.23.1-slim

WORKDIR /app

ENV CI=true
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

ARG PUBLIC_IS_SELFHOSTED=false
ARG PUBLIC_IS_SELF_OWNED=true

LABEL io.classroom.public-is-selfhosted="${PUBLIC_IS_SELFHOSTED}" \
      io.classroom.public-is-self-owned="${PUBLIC_IS_SELF_OWNED}"

RUN corepack enable && corepack prepare pnpm@10.19.0 --activate

COPY --from=builder /app /app

EXPOSE 3000

ENV NODE_ENV=production \
    PORT=3000 \
    PUBLIC_IS_SELFHOSTED=${PUBLIC_IS_SELFHOSTED} \
    PUBLIC_IS_SELF_OWNED=${PUBLIC_IS_SELF_OWNED}

WORKDIR /app/apps/dashboard
CMD ["node", "build/index.js"]
