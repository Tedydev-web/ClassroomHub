{
  "name": "classroom",
  "version": "0.1.13",
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "dev": "turbo prepare --concurrency 13 && turbo run dev",
    "lint": "turbo run lint",
    "clean": "turbo clean && rimraf --glob \"**/node_modules\"",
    "clean:pnpm": "pnpm clean && pnpm store prune",
    "format": "turbo run format",
    "format:all:check": "prettier --check . --ignore-unknown",
    "format:changed": "node scripts/format-changed.mjs --write",
    "format:check": "node scripts/format-changed.mjs --staged --check",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "dev:local": "bash scripts/start-development.sh",
    "dev:local:status": "bash scripts/start-development.sh status",
    "dev:local:stop": "bash scripts/start-development.sh stop",
    "dev:local:tunnel": "bash scripts/start-development.sh tunnel",
    "setup:env": "node scripts/setup-dev.mjs env",
    "setup:dev": "node scripts/setup-dev.mjs dev",
    "infra:up": "docker compose --env-file .env.dev -f docker-compose.dev.yaml up -d",
    "infra:down": "docker compose --env-file .env.dev -f docker-compose.dev.yaml down",
    "infra:status": "docker compose --env-file .env.dev -f docker-compose.dev.yaml ps",
    "test:scripts": "node scripts/run-script-tests.mjs",
    "check": "turbo run check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:scripts",
    "quality": "pnpm format:all:check && pnpm build && pnpm lint && pnpm check && pnpm typecheck && pnpm test",
    "postinstall": "node scripts/postinstall.mjs",
    "release": "standard-version",
    "db:reset": "pnpm --filter @cio/db db:reset",
    "db:studio": "pnpm --filter @cio/db db:studio",
    "db:backfill-profile-email-verification": "pnpm --filter @cio/db db:backfill-profile-email-verification",
    "dashboard:dev:full": "pnpm turbo run build --filter=@cio/dashboard^... --filter=@cio/ui^... && pnpm concurrently -n dashboard,ui -c blue,yellow \"pnpm --filter=@cio/dashboard run dev\" \"pnpm --filter=@cio/ui run dev\"",
    "dashboard:dev": "pnpm concurrently -n dashboard,ui -c blue,yellow \"pnpm --filter=@cio/dashboard run dev\" \"pnpm --filter=@cio/ui run dev\"",
    "api:dev:full": "pnpm turbo run build --filter=@cio/api^... --filter=@cio/jobs-worker^... && pnpm concurrently -n api,core,jobs -c blue,red,yellow \"pnpm --filter=@cio/api run dev\" \"pnpm --filter=@cio/core run dev\" \"pnpm --filter=@cio/jobs-worker run dev\"",
    "api:dev": "pnpm concurrently -n api,core,jobs -c blue,red,yellow \"pnpm --filter=@cio/api run dev\" \"pnpm --filter=@cio/core run dev\" \"pnpm --filter=@cio/jobs-worker run dev\"",
    "dev:core": "turbo run build --filter=@cio/dashboard^... --filter=@cio/api^... --filter=@cio/jobs-worker^... && turbo run dev --filter=@cio/dashboard... --filter=@cio/api... --filter=@cio/jobs-worker... --concurrency=20",
    "jobs:dev": "pnpm --filter=@cio/jobs-worker run dev",
    "docs:dev": "pnpm --filter @cio/docs dev",
    "docs:build": "pnpm --filter @cio/docs build",
    "docs:validate": "pnpm --filter @cio/docs validate",
    "website:dev": "pnpm --filter=@cio/website run dev",
    "embeds:dev": "pnpm --filter=@cio/embeds --filter=@cio/ui run dev",
    "storybook:dev": "pnpm --filter=@cio/storybook --filter=@cio/ui --filter=@cio/question-types run dev",
    "mcp:build": "pnpm --filter @cio/question-types build && pnpm --filter @cio/exam-import build && pnpm --filter @cio/utils build && pnpm --filter @tedydev/classroom-mcp build",
    "db:push": "pnpm --filter @cio/db db push"
  },
  "license": "MIT",
  "dependencies": {
    "turbo": "^1.10.16"
  },
  "devDependencies": {
    "@babel/plugin-syntax-jsx": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@cio/tsconfig": "workspace:*",
    "@evilmartians/lefthook": "^1.13.6",
    "concurrently": "^8.2.2",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.0.1",
    "standard-version": "^9.5.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": "^22.23.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "zod": "4.2.1",
      "miniflare>zod": "3.22.3",
      "blume>zod": "^3.24.0"
    }
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
