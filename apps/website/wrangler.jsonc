{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cio-web",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-03-13",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    {
      "binding": "DOCS",
      "service": "cio-docs"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  }
}
