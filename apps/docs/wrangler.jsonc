{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cio-docs",
  "compatibility_date": "2026-03-13",
  // The developer documentation is retired. Removing the marketing site's /docs
  // proxy alone would have left every page readable at
  // cio-docs.<subdomain>.workers.dev, so this worker stops carrying them:
  // `workers_dev: false` was deployed first and, an hour later, the address was
  // still serving pages, so the assets are gone and a 410 handler stands in
  // their place. The flag stays because it is still the correct intent.
  "workers_dev": false,
  "main": "src/gone.ts",

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
