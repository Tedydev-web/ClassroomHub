{
  "name": "@cio/jobs-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc && tsc-alias",
    "dev": "pnpm --filter @cio/jobs-worker --parallel \"/^dev:.*/\"",
    "dev:tsc": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:media": "tsx watch --include '../../packages/*/dist/index.js' src/workers/media.ts",
    "dev:media-transcribe": "tsx watch --include '../../packages/*/dist/index.js' src/workers/media-transcribe.ts",
    "dev:emails": "tsx watch --include '../../packages/*/dist/index.js' src/workers/emails.ts",
    "dev:notifications": "tsx watch --include '../../packages/*/dist/index.js' src/workers/notifications.ts",
    "dev:webhooks": "tsx watch --include '../../packages/*/dist/index.js' src/workers/webhooks.ts",
    "dev:maintenance": "tsx watch --include '../../packages/*/dist/index.js' src/workers/maintenance.ts",
    "dev:agent-course-generation": "tsx watch --include '../../packages/*/dist/index.js' src/workers/agent-course-generation.ts",
    "dev:exam-import": "tsx watch --include '../../packages/*/dist/index.js' src/workers/exam-import.ts",
    "start": "node dist/index.js",
    "start:media": "node dist/workers/media.js",
    "start:media-transcribe": "node dist/workers/media-transcribe.js",
    "start:emails": "node dist/workers/emails.js",
    "start:notifications": "node dist/workers/notifications.js",
    "start:webhooks": "node dist/workers/webhooks.js",
    "start:maintenance": "node dist/workers/maintenance.js",
    "start:agent-course-generation": "node dist/workers/agent-course-generation.js",
    "start:exam-import": "node dist/workers/exam-import.js",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.388.0",
    "@aws-sdk/s3-request-presigner": "^3.675.0",
    "@cio/analytics": "workspace:*",
    "@cio/core": "workspace:*",
    "@cio/db": "workspace:*",
    "@cio/email": "workspace:*",
    "@cio/exam-import": "workspace:*",
    "@cio/jobs": "workspace:*",
    "@cio/utils": "workspace:*",
    "bullmq": "^5.34.0",
    "dotenv": "^16.3.1",
    "ioredis": "^5.4.1",
    "isomorphic-dompurify": "^3.7.1",
    "openai": "^6.36.0",
    "pngjs": "5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.15.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.31.0",
    "globals": "^16.4.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^1.2.2",
    "zod": "^4.1.8"
  }
}
