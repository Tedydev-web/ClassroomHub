# Required
PORT=8001
DATABASE_URL=""
REDIS_URL=""
PUBLIC_SERVER_URL=""

TRUSTED_ORIGINS=""
BETTER_AUTH_SECRET=""
# Google OAuth Web client. Register <PUBLIC_SERVER_URL>/api/auth/callback/google
# as an authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
PRIVATE_SERVER_KEY=""
WEBHOOK_ENCRYPTION_KEY=""
HLS_SIGNING_SECRET=""
PUBLIC_IS_SELFHOSTED=false
PUBLIC_IS_SELF_OWNED=true
# Default-off server gate for document-to-exam import writes.
EXAM_IMPORT_ENABLED=false
# Default-off server admission gate for text-based PDF exam imports.
EXAM_IMPORT_PDF_ENABLED=false
# Global rollback switch; organization consent is also required.
EXAM_IMPORT_AI_ENABLED=false
EXAM_IMPORT_AI_MODEL=
EXAM_IMPORT_VISION_ENABLED=false
EXAM_IMPORT_VISION_MODEL=
DASHBOARD_ORIGIN=""

AUTH_COOKIE_DOMAIN=""

# Email provider — used by the API only for auth-flow emails (forgot
# password, password-reset confirmation, email verification, email-change
# verification). Every other email is sent by @cio/jobs-worker; see
# apps/jobs/.env.example. Both processes can point at the same SMTP server.
#
# SMTP_SENDER must be a full RFC 5322 address. Quote the display name:
#     SMTP_SENDER='"ClassroomHub" <support@classroom.io.vn>'
# A bare address also works. Send from the product domain with SPF and DKIM
# published — a consumer mailbox cannot sign for this domain, so invites from
# one land in spam or get rejected outright.
#
# Local development points at the Mailpit catcher from docker-compose, which
# accepts everything and delivers nothing. Read it at http://127.0.0.1:8007.
#     SMTP_HOST="127.0.0.1"   SMTP_PORT="8006"
#     SMTP_SECURE="false"     SMTP_REQUIRE_TLS="false"
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
SMTP_REQUIRE_TLS=""
SMTP_USER=""
SMTP_SENDER=""
SMTP_PASSWORD=""

# Optional Zoho ZeptoMail token. When set, @cio/email uses Zoho instead of
# nodemailer/SMTP. Same dual-process note as SMTP above.
# ZOHO_TOKEN=""

# Optional - MinIO (S3-compatible, for Docker / on-premise self-hosting)
# When API runs in Docker: use http://minio:9000. For local API: use http://localhost:8004
MINIO_ROOT_USER=""
MINIO_ROOT_PASSWORD=""
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_PUBLIC_ENDPOINT=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_FORCE_PATH_STYLE=""
OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL=""
OBJECT_STORAGE_BUCKET_VIDEOS=""
OBJECT_STORAGE_BUCKET_DOCUMENTS=""
OBJECT_STORAGE_BUCKET_MEDIA=""

# Optional - Cloudflare R2 (for hosted deployments)
CLOUDFLARE_BUCKET_ID=""
CLOUDFLARE_ACCESS_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_BUCKET_DOMAIN=""
CLOUDFLARE_SECRET_ACCESS_KEY=""

# HMAC secret used to sign the `cio_hls` playback cookie. The same value must
# be set on the tenant-router Worker (`wrangler secret put HLS_SIGNING_SECRET`)
# so segments served from R2 at the edge verify against this signature.
# Without it the cookie endpoints return 503 and HLS playback won't start —
# uploads still work, so leave it unset for upload-only local development.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
HLS_SIGNING_SECRET=""

# Sentry (server-side error tracking). Leave SENTRY_DSN unset to disable.
# Skipped automatically in dev (NODE_ENV !== 'production') and self-hosted (PUBLIC_IS_SELFHOSTED=true).
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="0"

# BullMQ dashboard (/admin/queues) ───────────────────────────────────────────
# In dev the dashboard is open. In production it's hidden unless ONE of the
# following is set; failing requests get 404 (not 401) so the route stays
# invisible to scanners.
#
# Comma-separated allowlist of Better Auth user emails — log in normally,
# visit /admin/queues, the middleware checks your session.
# QUEUE_DASHBOARD_ADMIN_EMAILS="you@yourdomain.com,partner@yourdomain.com"
#
# Bearer-token escape hatch for curl / scripts. Pass via
# `Authorization: Bearer <token>` or `?token=<token>`.
# QUEUE_DASHBOARD_TOKEN=""

# SSO (Optional)
# For enterprise SSO with SAML (future support)
# SSO_ENCRYPTION_KEY="your-32-character-secret-key"

# AI Assistant (Optional)
# The picker exposes Gemini 2.5 Flash Lite, Kimi K2.6, GPT-5.4 Mini, and Claude Sonnet 4.6.
# Set at least one matching provider key to enable the assistant.
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
MOONSHOT_API_KEY=""

# AI Gateway (Optional) — OpenAI-compatible subscription proxy (CCS/CLIProxy).
# When enabled, AI traffic prefers this gateway and falls back to the official
# API keys above. Runtime behavior (pause, model allowlist, concurrency, per-org
# limits) is stored in the database, not here; only connection details are env.
# The token below is the proxy's own API key — never an OAuth token. OAuth
# credentials stay inside the gateway container and must never be copied here.
AI_GATEWAY_BASE_URL=""
AI_GATEWAY_AUTH_TOKEN=""

# Gates the operator API at /admin/ai/* (health, quota, kill switch, per-org
# priority). Unset in production leaves those routes refusing every request.
SUPER_ADMIN_PASSWORD=""

# Jina Reader — optional Bearer for higher rate limits when using fetch_documentation_url
# JINA_API_KEY=""
# AGENT_MAX_FETCHES_PER_CONVERSATION=15
# AGENT_MAX_FETCHES_PER_ORG_PER_DAY=500

# Upload file size limits (megabytes). Set these on both API and dashboard for self-hosted installs.
# UPLOAD_MAX_DOCUMENT_MB=5
# UPLOAD_MAX_IMAGE_MB=5
# UPLOAD_MAX_VIDEO_MB=800
# UPLOAD_MAX_EXERCISE_FILE_MB=2
# UPLOAD_MAX_AGENT_DOCUMENT_MB=5
# UPLOAD_MAX_LANDING_IMAGE_MB=0.5
# UPLOAD_MAX_THUMBNAIL_MB=5

# Tinybird event tracking for AI observability (optional — silently skipped when not set)
# TINYBIRD_TOKEN=""
# TINYBIRD_BASE_URL="https://api.tinybird.co"

# Comma-separated brand-zone hosts served as org sites (e.g. academy.classroomhub.com).
# Leave empty to keep every platform host reserved.
FIRST_PARTY_ORG_SITE_HOSTS=""
