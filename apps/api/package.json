{
  "name": "@cio/api",
  "version": "0.0.1",
  "description": "Classroom API and background-process backend",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc && tsc-alias",
    "build:clean": "rimraf dist tsconfig.tsbuildinfo && pnpm run build",
    "dev": "concurrently -n server,types -c blue,yellow --restart-tries -1 --restart-after 1000 \"pnpm run dev:server\" \"pnpm run dev:tsc\"",
    "dev:server": "node --import tsx --watch --watch-preserve-output src/index.ts",
    "dev:tsc": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "deploy": "wrangler deploy",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:scorm-smoke": "tsx scripts/scorm-smoke.ts",
    "seed:passage-workspace": "tsx scripts/seed-passage-workspace-demo.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "upload:openapi": "tsx scripts/upload-openapi-spec.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tedydev-web/classroomio.git"
  },
  "author": "Classroom <support@classroom.io.vn>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Tedydev-web/classroomio/issues"
  },
  "homepage": "https://github.com/Tedydev-web/classroomio#readme",
  "exports": {
    "./rpc-types": {
      "types": "./dist/rpc-types.d.ts",
      "default": "./dist/rpc-types.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.388.0",
    "@aws-sdk/s3-request-presigner": "^3.675.0",
    "@cio/ai-assistant": "workspace:*",
    "@cio/analytics": "workspace:*",
    "@cio/certificates": "workspace:*",
    "@cio/core": "workspace:*",
    "@cio/db": "workspace:*",
    "@cio/email": "workspace:*",
    "@cio/jobs": "workspace:*",
    "@cio/question-types": "workspace:*",
    "@cio/utils": "workspace:*",
    "@getworkbench/hono": "0.2.1",
    "@hono/node-server": "^1.19.7",
    "@hono/standard-validator": "^0.1.5",
    "@hono/zod-validator": "^0.7.6",
    "@scalar/hono-api-reference": "^0.9.18",
    "@sentry/node": "^10.53.1",
    "ai": "^6.0.158",
    "axios": "^1.4.0",
    "css-tree": "^3.2.1",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.44.7",
    "fast-xml-parser": "5.2.5",
    "hono": "^4.11.3",
    "hono-openapi": "^1.0.8",
    "hono-rate-limiter": "^0.4.2",
    "isomorphic-dompurify": "^3.7.1",
    "jszip": "3.10.1",
    "katex": "^0.16.10",
    "marked": "^7.0.3",
    "nanoid": "^5.1.5",
    "tldts": "^6.1.86",
    "zod": "^4.1.8",
    "zod-openapi": "^5.4.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.0",
    "@eslint/js": "^9.36.0",
    "@vitest/coverage-v8": "^1.2.2",
    "eslint": "^9.31.0",
    "globals": "^16.4.0",
    "prettier": "3.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.1",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^1.2.2",
    "wrangler": "4.21.x"
  }
}
